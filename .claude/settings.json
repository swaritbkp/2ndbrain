{
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "MultiEdit", "Glob", "Grep", "WebSearch", "WebFetch", "TodoWrite", "Task", "Agent",
      "Bash(python:*)", "Bash(python3:*)", "Bash(py:*)", "Bash(pip:*)", "Bash(.venv/Scripts/python:*)", "Bash(.venv/bin/python:*)",
      "Bash(.venv/Scripts/pip:*)", "Bash(.venv/bin/pip:*)", "Bash(pytest:*)", "Bash(streamlit:*)", "Bash(uvicorn:*)",
      "Bash(node:*)", "Bash(npm:*)", "Bash(npx:*)", "Bash(synapse:*)", "Bash(timeout:*)", "Bash(soffice:*)", "Bash(libreoffice:*)",
      "Bash(git init:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(git log:*)", "Bash(git ls-files:*)", "Bash(git rev-parse:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(grep:*)", "Bash(find:*)", "Bash(sort:*)", "Bash(diff:*)",
      "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(rm:*)", "Bash(touch:*)", "Bash(echo:*)", "Bash(cd:*)", "Bash(pwd)", "Bash(which:*)", "Bash(where:*)",
      "Bash(sleep:*)", "Bash(sed:*)", "Bash(test:*)", "Bash(source:*)", "Bash(chmod:*)", "Bash(unzip:*)", "Bash(zip:*)",
      "Bash(bash scripts/:*)", "Bash(sh scripts/:*)", "Bash(powershell -File scripts/:*)", "Bash(pwsh -File scripts/:*)"
    ],
    "deny": [
      "Read(./.env)", "Edit(./.env)", "Write(./.env)",
      "Bash(git push:*)", "Bash(git reset --hard:*)", "Bash(curl:*)", "Bash(wget:*)", "Bash(synapse init:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|Read", "hooks": [{ "type": "command", "command": "python .claude/hooks/guard.py" }] }
    ]
  }
}
