# ===== Required =====
# One OpenRouter key powers everything: the arena agents, the attacker, and Synapse --local builds.
OPENROUTER_API_KEY=
REKHA_TOKEN_SECRET=change-me-long-random-string

# Agent under test (BOTH arms use it). Verified on OpenRouter 2026-11-23 as tool-capable:
#   nvidia/nemotron-3.5-super-vl        (120B MoE, 12B active; stronger, recommended as primary)
#   nvidia/nemotron-3.5-lightning       (30B MoE, 3B active; cheap, ideal for the sweep)
#   ...:free variants exist but have strict rate/daily limits. Avoid them for the full arena.
# scripts/openrouter_models.py re-validates these and substitutes (and logs) if one is unavailable.
ARENA_BASE_URL=https://openrouter.ai/api/v1
ARENA_MODEL=nvidia/nemotron-3.5-super-vl
ARENA_SWEEP_MODELS=nvidia/nemotron-3.5-lightning
ATTACKER_MODEL=nvidia/nemotron-3.5-super-vl
ARENA_TEMPERATURE=0.2
ARENA_RUNS=3
ARENA_RPM=20
ARENA_TOKEN_BUDGET=4000000
ARENA_ALLOW_FREE=0

# Synapse --local code generation via OpenRouter. Code generation needs a model that follows a strict schema;
# if Nemotron fails with "emit_tool_plan", list stronger OpenRouter models to fall back to (comma-separated).
SYNAPSE_PROVIDER=openrouter
SYNAPSE_MODEL=nvidia/nemotron-3.5-super-vl
SYNAPSE_MODEL_FALLBACKS=

# Engine
REKHA_AS_OF=2026-11-23
REKHA_NOW=2026-11-23T14:55:00+05:30
SYNAPSE_TELEMETRY=0
